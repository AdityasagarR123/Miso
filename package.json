{
  "name": "biso",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/progress/progress.test.mjs src/course/spanish.test.mjs src/course/buildCourse.test.mjs src/course/writing.test.mjs src/auth/authHelpers.test.mjs src/components/map/roadLayout.test.mjs",
    "build:web": "node scripts/check-firebase-env.mjs && npm test && npm run -s typecheck && expo export --platform web --output-dir dist"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
